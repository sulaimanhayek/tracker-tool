<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Focus.App"
        x:Class="Focus.App.MainWindow"
        Title="Focus" Width="900" Height="720"
        MinWidth="720" MinHeight="620"
        WindowStartupLocation="CenterScreen">

  <DockPanel Name="Root">
    <Border DockPanel.Dock="Top" Padding="14,10" Name="HeaderBar">
      <Grid ColumnDefinitions="*,Auto,*">
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
          <Button Name="TimerTab" Classes="page" Content="Timer" Click="ShowTimer" />
          <Button Name="NotesTab" Classes="page" Content="Notes" Click="ShowNotes" />
          <Button Name="StatsTab" Classes="page" Content="Insights" Click="ShowStats" />
        </StackPanel>

        <Button Grid.Column="2" HorizontalAlignment="Right" Classes="page"
                Click="OpenSettings" ToolTip.Tip="Settings — durations, background, data folder">
          <PathIcon Width="15" Height="15"
                    Data="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm0 6a2 2 0 1 1 0-4 2 2 0 0 1 0 4zm9.4-2 1.5-1.2-1.7-3-1.8.7a7.6 7.6 0 0 0-1.6-.9l-.3-2h-3.4l-.3 2c-.6.2-1.1.5-1.6.9l-1.8-.7-1.7 3L10.2 12a7 7 0 0 0 0 1.9l-1.5 1.2 1.7 3 1.8-.7c.5.4 1 .7 1.6.9l.3 2h3.4l.3-2c.6-.2 1.1-.5 1.6-.9l1.8.7 1.7-3-1.5-1.2c.1-.6.1-1.3 0-1.9z" />
        </Button>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="20,0,20,10" Name="ErrorBar" IsVisible="False">
      <TextBlock Name="ErrorText" Foreground="#ff6b6b" FontSize="12" TextWrapping="Wrap" />
    </Border>

    <ContentControl Name="PageHost" />
  </DockPanel>
</Window>
